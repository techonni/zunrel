---
// Page d'un guide traduit (/pt/guias/… ou /en/guides/…). Texte de la traduction ;
// sources et bouton affilié repris du guide français.
import Base from "../layouts/Base.astro";
import { affiliateLinks, getGuide, type Guide } from "../lib/guides";
import NewsletterForm from "./NewsletterForm.astro";
import AffiliateCta from "./AffiliateCta.astro";
import { appIcon, iconOf, picInner, shortDate } from "../lib/v3";
import {
  localizeSource,
  getTranslation,
  guideAlternates,
  listPath,
  translatedPath,
  translations,
  ui,
  type OtherLang,
  type TranslatedGuide,
} from "../lib/i18n";

interface Props {
  lang: OtherLang;
  item: TranslatedGuide;
}

const { lang, item } = Astro.props;
const t = ui[lang];
const guide = getGuide(item.slug) as Guide;
const other: OtherLang = lang === "pt" ? "en" : "pt";
const otherItem = getTranslation(other, item.slug);
const sources = guide.sources
  .map((source) => localizeSource(lang, source))
  .filter((source): source is { label: string; url: string } => source !== null);
// Guides liés du guide français quand ils sont traduits, complétés par les autres traductions.
const relatedFirst = guide.related.map((slug) => getTranslation(lang, slug)).filter((entry): entry is TranslatedGuide => Boolean(entry));
const related = [...relatedFirst, ...translations[lang].filter((entry) => entry.slug !== item.slug && !relatedFirst.includes(entry))].slice(0, 4);
const minutes = Math.max(1, Math.round(item.steps.map((step) => step.text).join(" ").split(/\s+/).length / 200));
const date = new Intl.DateTimeFormat(lang === "pt" ? "pt-BR" : "en-US", { day: "numeric", month: "long", year: "numeric" }).format(
  new Date(guide.updatedOn),
);
const L = lang === "pt"
  ? { guide: "Guia", by: "Por", copy: "Copiar o link do guia", copied: "Link copiado", pdf: "Baixar em PDF" }
  : { guide: "Guide", by: "By", copy: "Copy the guide link", copied: "Link copied", pdf: "Download as PDF" };
const cta = { href: affiliateLinks[lang], tool: "systeme-io", short: t.ctaShort, text: t.cta, label: t.ctaLabel };

const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: item.question,
  description: item.summary,
  inLanguage: lang === "pt" ? "pt" : "en-US",
  step: item.steps.map((step, index) => ({ "@type": "HowToStep", position: index + 1, name: step.title, text: step.text })),
};
---

<Base
  bare
  lang={lang}
  title={item.question}
  description={item.summary}
  image={`/pins/minimal/${guide.slug}.jpg`}
  type="article"
  alternates={guideAlternates(item.slug)}
  breadcrumbs={[{ name: t.home, path: listPath(lang) }, { name: item.question }]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howTo)} />

  <article>
    <div class="art3">
      <p class="kat no-print"><a href={listPath(lang)}>{L.guide}</a></p>
      <h1>{item.question}</h1>
      <p class="subt">{item.summary}</p>
      <div class="byl">
        <p>
          {L.by} <a href="/a-propos/" hreflang="fr">Dario Pinheiro</a>
          <time datetime={guide.updatedOn}>{t.updated} {date} · {t.reading}: {minutes} min</time>
          <span class="alt no-print">
            <a href={`/guides/${guide.slug}/`} hreflang="fr">{t.frenchVersion}</a>
            {otherItem ? <> · <a href={translatedPath(other, otherItem.localSlug)} hreflang={other}>{t.otherLang}</a></> : null}
          </span>
        </p>
        <span class="acts no-print">
          <button class="cp" type="button" data-print aria-label={L.pdf} title={L.pdf}>
            <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14" /></svg>
          </button>
          <button class="cp" type="button" data-copy aria-label={L.copy} title={L.copy}>
            <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"/></svg><em>{L.copied}</em>
          </button>
        </span>
      </div>
      <div class="pic" set:html={appIcon(iconOf(guide.slug))} />
    </div>

    <div class="prose">
      <p>{item.intro}</p>
      <AffiliateCta placement="haut" lang={lang} />

      <h2>{t.inShort}</h2>
      <ol>{item.steps.map((step) => <li>{step.title}</li>)}</ol>
      {item.pitfalls[0] ? <p><strong>{t.avoid}</strong> {item.pitfalls[0]}</p> : null}

      <h2 id="steps">{t.stepByStep}</h2>
      <p class="uin">{t.uiNote}</p>
      <ol class="steps3">
        {item.steps.map((step, index) => (
          <li>
            <h3><span>{index + 1}.</span>{step.title}</h3>
            {step.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
          </li>
        ))}
      </ol>

      <h2 class="no-print">{t.tryYourself}</h2>
      <AffiliateCta placement="bas" lang={lang} />

      {
        item.pitfalls.length > 0 ? (
          <>
            <h2>{t.pitfalls}</h2>
            <ul>{item.pitfalls.map((pitfall) => <li>{pitfall}</li>)}</ul>
          </>
        ) : null
      }

      {
        sources.length > 0 ? (
          <>
            <h2>{t.sources}</h2>
            <ul>{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>)}</ul>
          </>
        ) : null
      }
    </div>
  </article>

  <section class="more3 no-print">
    <h3 class="sh">{t.readNext}</h3>
    <div class="list">
      {
        related.map((entry) => (
          <a href={translatedPath(lang, entry.localSlug)} class="card">
            <div class="pic" set:html={picInner(entry.slug, true)} />
            <div class="ct">
              <p class="date">{shortDate((getGuide(entry.slug) as Guide).updatedOn, lang)}</p>
              <h4>{entry.question}</h4>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="sub3 no-print" id="newsletter">
    <NewsletterForm lang={lang} />
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
        } catch {
          const t = document.createElement("textarea");
          t.value = location.href;
          document.body.append(t);
          t.select();
          document.execCommand("copy");
          t.remove();
        }
        button.classList.add("done");
        setTimeout(() => button.classList.remove("done"), 1600);
      });
    });
  </script>
</Base>
