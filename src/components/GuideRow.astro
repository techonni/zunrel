---
// Carte de guide v3 : vignette (écran de téléphone ou icône d'app), date, question, résumé.
import { href } from "../lib/paths";
import { readingMinutes, type Guide } from "../lib/guides";
import { frTypo, picInner, shortDate } from "../lib/v3";

interface Props {
  guide: Guide;
  desc?: boolean;
  minutes?: boolean;
}

const { guide, desc = true, minutes = true } = Astro.props;
---

<a href={href(`/guides/${guide.slug}`)} class="card">
  <div class="pic" set:html={picInner(guide.slug)} />
  <div class="ct">
    <p class="date">{shortDate(guide.updatedOn)}{minutes ? ` · ${readingMinutes(guide)} min` : ""}</p>
    <h4>{frTypo(guide.question)}</h4>
    {desc ? <p class="desc">{guide.summary}</p> : null}
  </div>
</a>
