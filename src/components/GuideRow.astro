---
import { href } from "../lib/paths";
import { readingMinutes, type Guide } from "../lib/guides";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
---

<!-- Ligne de liste minimaliste (classes m-row / m-arrow dans global.css). -->
<a href={href(`/guides/${guide.slug}`)} class="m-row group">
  <span class="m-body">
    <span class="block text-[15px] font-medium leading-5 text-white">{guide.question}</span>
    <span class="mt-1 block text-[14px] leading-5 text-[#95959b]">{guide.summary}</span>
    <span class="mt-1 block text-[13px] leading-5 text-[#808086]">Lecture : {readingMinutes(guide)} min</span>
  </span>
  <span class="m-arrow" aria-hidden="true">→</span>
</a>
