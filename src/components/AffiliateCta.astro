---
// Encadré affilié systeme.io d'un guide (style v3 : encadré gris clair, bouton noir arrondi).
// Placé deux fois : en haut (après l'intro, version courte) et en bas (après les étapes).
// `data-placement` part dans l'événement GA4 `affiliate_click`.
// Chaque lien affilié : rel="sponsored noopener", nouvel onglet, et la mention affiliée visible.
import { affiliateLinks, affiliateDisclosure } from "../lib/guides";
import { ui, type Lang } from "../lib/i18n";

interface Props {
  placement: "haut" | "bas";
  lang?: Lang;
}

const { placement, lang = "fr" } = Astro.props;

// Textes alignés sur la page officielle des tarifs (vérifiée le 04/10/2026).
const cta =
  lang === "fr"
    ? {
        short: "Pour suivre ce guide, il vous faut un compte systeme.io : le plan gratuit ne demande pas de carte bancaire.",
        text: "systeme.io a un plan gratuit, sans carte bancaire et sans limite de durée. Vous pouvez tout construire avant de payer quoi que ce soit.",
        label: "Créer un compte gratuit systeme.io ↗",
      }
    : { short: ui[lang].ctaShort, text: ui[lang].cta, label: ui[lang].ctaLabel };
const href = affiliateLinks[lang];
const disclosure = affiliateDisclosure[lang];
const dataPlacement = lang === "fr" ? placement : `${placement}-${lang}`;
---

<div class="note no-print" data-pagefind-ignore>
  <p>{placement === "haut" ? cta.short : cta.text}</p>
  <a class="pill black" href={href} target="_blank" rel="sponsored noopener" data-affiliate="systeme-io" data-placement={dataPlacement}>{cta.label}</a>
  <small>{disclosure}</small>
</div>
