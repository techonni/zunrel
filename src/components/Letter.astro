---
// La lettre du dimanche : formulaire « embedded » Mailchimp (double opt-in géré par Mailchimp).
// Envoi en arrière-plan (point d'accès JSONP « post-json ») ; sinon, envoi dans une iframe cachée.
import { f, freeGuide, newsletter } from "../lib/site";

interface Props {
  id: string;
  // h1 sur la page /newsletter/, h2 ailleurs.
  heading?: "h1" | "h2";
  plain?: boolean;
}
const { id, heading = "h2", plain = false } = Astro.props;
const Heading = heading;
const messages = {
  send: "Envoi…",
  button: "Recevoir le guide",
  thanks: "Merci !",
  confirm: f("Dernière étape : ouvre l'e-mail envoyé à {email} et clique sur le bouton pour confirmer."),
  already: f("Tu es déjà inscrit."),
  alreadyText: f("La prochaine lettre arrive dimanche."),
  invalid: f("Entre une adresse e-mail valide, par exemple toi@exemple.com."),
  tooMany: f("Trop de tentatives avec cette adresse. Réessaie dans quelques minutes."),
  failed: f("Cette adresse n'a pas pu être inscrite. Vérifie-la et réessaie."),
};
---

<section class:list={[plain ? "page" : "letter"]} id="lettre" data-newsletter-block data-messages={JSON.stringify(messages)}>
  <Heading>La lettre du dimanche</Heading>
  <p class:list={[plain ? "lead" : "t"]}>{f("Chaque semaine, un e-mail court : une idée, un réglage, une alternative plus simple. Rien d'autre.")}</p>
  <div data-newsletter-intro>
    <p class="gift">{f(`À l'inscription, reçois le ${freeGuide.replace("Guide gratuit", "guide gratuit")}.`)}</p>
    <form class="nlf" action={newsletter.action} method="post" target="zunrel-newsletter-frame" novalidate data-newsletter>
      <input type="hidden" name="tags" value={newsletter.tag} />
      <label for={id}>Adresse e-mail</label>
      <div class="row">
        <input id={id} type="email" name="EMAIL" required autocomplete="email" inputmode="email" placeholder="toi@exemple.com" aria-describedby={`${id}-help`} />
        <div class="hp" aria-hidden="true"><input type="text" name={newsletter.honeypot} tabindex="-1" value="" /></div>
        <button type="submit"><span data-newsletter-label>{messages.button}</span></button>
      </div>
      <p class="msg" id={`${id}-help`} data-newsletter-message aria-live="polite">{f("Tu recevras un e-mail pour confirmer. Désinscription en un clic.")}</p>
    </form>
  </div>
  <div class="done" data-newsletter-done hidden tabindex="-1">
    <strong data-newsletter-done-title>{messages.thanks}</strong>
    <p data-newsletter-done-text></p>
  </div>
  <iframe name="zunrel-newsletter-frame" title="Inscription à la lettre" hidden tabindex="-1"></iframe>
</section>

<script is:inline>
  (function () {
    var block = document.querySelector("[data-newsletter-block]");
    if (!block) return;
    var form = block.querySelector("form[data-newsletter]");
    var intro = block.querySelector("[data-newsletter-intro]");
    var done = block.querySelector("[data-newsletter-done]");
    var doneTitle = block.querySelector("[data-newsletter-done-title]");
    var doneText = block.querySelector("[data-newsletter-done-text]");
    var message = block.querySelector("[data-newsletter-message]");
    var input = form.querySelector('input[name="EMAIL"]');
    var button = form.querySelector('button[type="submit"]');
    var label = button.querySelector("[data-newsletter-label]");
    var defaultHelp = message.textContent;
    var storageKey = "zunrel-newsletter";
    var m = JSON.parse(block.getAttribute("data-messages") || "{}");
    function remember() { try { localStorage.setItem(storageKey, "1"); } catch (e) {} }
    function setBusy(busy) { button.disabled = busy; label.textContent = busy ? m.send : m.button; input.readOnly = busy; }
    function setError(text) { input.setAttribute("aria-invalid", "true"); message.textContent = text; message.classList.add("err"); input.focus(); }
    function clearError() { input.removeAttribute("aria-invalid"); message.textContent = defaultHelp; message.classList.remove("err"); }
    function showDone(title, text, moveFocus) {
      doneTitle.textContent = title; doneText.textContent = text;
      intro.hidden = true; done.hidden = false;
      if (moveFocus !== false) done.focus({ preventScroll: true });
    }
    try { if (localStorage.getItem(storageKey) === "1") showDone(m.already, m.alreadyText, false); } catch (e) {}
    input.addEventListener("input", function () { if (input.hasAttribute("aria-invalid")) clearError(); });
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (!input.value.trim() || !input.checkValidity()) { event.stopPropagation(); setError(m.invalid); return; }
      var email = input.value.trim();
      var name = "zunrelNewsletter" + Date.now();
      var url = form.action.replace("/subscribe/post?", "/subscribe/post-json?");
      var params = new URLSearchParams(new FormData(form));
      params.set("c", name);
      var script = document.createElement("script");
      var finished = false;
      function finish() { finished = true; clearTimeout(fallback); setBusy(false); delete window[name]; script.remove(); }
      function success() { remember(); showDone(m.thanks, m.confirm.replace("{email}", email)); }
      function sendInFrame() { if (finished) return; finish(); form.submit(); success(); }
      var fallback = setTimeout(sendInFrame, 8000);
      window[name] = function (data) {
        if (finished) return;
        finish();
        var msg = (data && data.msg) || "";
        if (data && data.result === "success") success();
        else if (/already subscribed|déjà inscrit/i.test(msg)) { remember(); showDone(m.already, m.alreadyText); }
        else if (/too many|trop de/i.test(msg)) setError(m.tooMany);
        else setError(m.failed);
      };
      clearError(); setBusy(true);
      script.src = url + "&" + params.toString();
      script.onerror = sendInFrame;
      document.body.appendChild(script);
    });
  })();
</script>
