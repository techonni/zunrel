---
import BrandLogo from "./BrandLogo.astro";
import { href } from "../lib/paths";
import type { Tool } from "../lib/guides";

interface Props {
  tool: Tool;
  note?: string;
}

const { tool, note } = Astro.props;
---

<a href={href(`/outils/${tool.slug}`)} class="group flex items-center gap-4">
  <BrandLogo tool={tool} />
  <span class="min-w-0">
    <span class="block text-[15px] font-medium leading-5 text-white group-hover:underline">
      {tool.name} →
    </span>
    <span class="mt-0.5 block text-[14px] leading-5 text-[#95959b]">{note ?? tool.summary}</span>
  </span>
</a>
