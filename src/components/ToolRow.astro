---
import BrandLogo from "./BrandLogo.astro";
import { href } from "../lib/paths";
import type { Tool } from "../lib/guides";

interface Props {
  tool: Tool;
  note?: string;
}

const { tool, note } = Astro.props;
---

<!-- Ligne de liste minimaliste (classes m-row / m-arrow dans global.css). -->
<a href={href(`/outils/${tool.slug}`)} class="m-row group">
  <BrandLogo tool={tool} />
  <span class="m-body">
    <span class="block text-[15px] font-medium leading-5 text-white">{tool.name}</span>
    <span class="mt-0.5 block text-[14px] leading-5 text-[#95959b]">{note ?? tool.summary}</span>
  </span>
  <span class="m-arrow" aria-hidden="true">→</span>
</a>
