---
// Barre discrète en bas de l'écran, sur les pages guides : elle apparaît quand le lecteur a lu
// environ 60 % du guide, et renvoie vers le bloc newsletter de la page (pas de pop-up qui cache
// la lecture). Elle ne s'affiche pas si le visiteur est déjà inscrit, si le bandeau cookies est
// ouvert, si le bloc newsletter est déjà à l'écran, ni pendant 14 jours après une fermeture.
interface Props {
  gift: string;
}
const { gift } = Astro.props;
---

<div data-newsletter-bar hidden class="nbar no-print">
  <p>{gift}</p>
  <button type="button" data-newsletter-bar-go class="go">Recevoir</button>
  <button type="button" data-newsletter-bar-close aria-label="Fermer" class="x">×</button>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector("[data-newsletter-bar]");
    var block = document.querySelector("[data-newsletter-block]");
    if (!bar || !block) return;
    var key = "zunrel-newsletter-bar";
    try {
      if (localStorage.getItem("zunrel-newsletter") === "1") return;
      var closed = Number(localStorage.getItem(key) || 0);
      if (closed && Date.now() - closed < 14 * 86400000) return;
    } catch (e) {}

    var blockVisible = false;
    var done = false;
    new IntersectionObserver(function (entries) {
      blockVisible = entries[0].isIntersecting;
      update();
    }).observe(block);

    function consentOpen() {
      var consent = document.getElementById("zunrel-consent");
      return consent && !consent.hidden;
    }

    function update() {
      if (done) return;
      var doc = document.documentElement;
      var progress = (window.scrollY + window.innerHeight) / doc.scrollHeight;
      bar.hidden = !(progress > 0.6 && !blockVisible && !consentOpen());
    }

    function close() {
      done = true;
      bar.hidden = true;
      try {
        localStorage.setItem(key, String(Date.now()));
      } catch (e) {}
    }

    window.addEventListener("scroll", update, { passive: true });
    bar.querySelector("[data-newsletter-bar-close]").addEventListener("click", close);
    bar.querySelector("[data-newsletter-bar-go]").addEventListener("click", function () {
      done = true;
      bar.hidden = true;
      block.scrollIntoView({ behavior: "smooth", block: "center" });
      var input = block.querySelector('input[name="EMAIL"]');
      if (input) setTimeout(function () { input.focus({ preventScroll: true }); }, 500);
      if (window.gtag) gtag("event", "newsletter_bar_click", { page: location.pathname });
    });
  })();
</script>
