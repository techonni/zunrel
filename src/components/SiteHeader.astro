---
// En-tête v3 : logo Z + nom, liens sur ordinateur, bouton menu sur mobile.
// Le bouton menu ouvre une simple liste sous l'en-tête (pas de fenêtre par-dessus la page).
import { logoSvg } from "../lib/v3";
import { ui, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  alternates?: { lang: Lang; path: string }[];
}

const { lang = "fr", alternates } = Astro.props;
const path = Astro.url.pathname;
const homeHref = lang === "pt" ? "/pt/" : lang === "en" ? "/en/" : "/";

const links =
  lang === "fr"
    ? [
        { href: "/guides/", label: "Guides" },
        { href: "/#fonctions", label: "Fonctions" },
        { href: "/themes/comparer/", label: "Comparatifs" },
        { href: "/newsletter/", label: "Newsletter" },
      ]
    : lang === "pt"
      ? [
          { href: "/pt/", label: "Guias" },
          { href: "/guides/", label: "Guias em francês" },
        ]
      : [
          { href: "/en/", label: "Guides" },
          { href: "/guides/", label: "Guides in French" },
        ];
const menuExtra =
  lang === "fr"
    ? [
        { href: "/a-propos/", label: "À propos" },
        { href: "/offres/", label: "Offres du moment" },
      ]
    : [];

// Sélecteur de langue : la version traduite de la page si elle existe, sinon l'accueil de la langue.
const homes: Record<Lang, string> = { fr: "/", pt: "/pt/", en: "/en/" };
const switcher = (["fr", "pt", "en"] as const).map((code) => ({
  code,
  label: code.toUpperCase(),
  href: alternates?.find((item) => item.lang === code)?.path ?? homes[code],
}));
const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href) && !(href === "/guides/" && lang !== "fr");
---

<header class="hd" data-sticky-header>
  <a class="brand" href={homeHref} aria-label={`Zunrel, ${ui[lang].home}`}><Fragment set:html={logoSvg(30)} /><b>Zunrel</b></a>
  <div class="r">
    <nav class="nav" aria-label="Menu principal">
      {links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <nav class="langs" aria-label="Langue / Language / Idioma">
      {switcher.map((item) => (item.code === lang ? <span aria-current="true" style="color:#000">{item.label}</span> : <a href={item.href} hreflang={item.code}>{item.label}</a>))}
    </nav>
    <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu" data-menu-button><i></i><i></i><i></i></button>
  </div>
</header>
<nav id="site-menu" class="mnu" hidden aria-label="Menu">
  {[...links, ...menuExtra].map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>)}
  <div class="lg">
    {switcher.map((item) => (item.code === lang ? <span aria-current="true">{item.label}</span> : <a href={item.href} hreflang={item.code}>{item.label}</a>))}
  </div>
</nav>
<script is:inline>
  (function () {
    var header = document.querySelector("[data-sticky-header]");
    var button = document.querySelector("[data-menu-button]");
    var menu = document.getElementById("site-menu");
    if (header) {
      var update = function () { header.toggleAttribute("data-scrolled", window.scrollY > 4); };
      update();
      window.addEventListener("scroll", update, { passive: true });
    }
    if (!button || !menu) return;
    function set(open) {
      menu.hidden = !open;
      button.setAttribute("aria-expanded", open ? "true" : "false");
    }
    button.addEventListener("click", function () { set(menu.hidden); });
    menu.addEventListener("click", function (event) { if (event.target.closest("a")) set(false); });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && !menu.hidden) { set(false); button.focus(); }
    });
  })();
</script>
