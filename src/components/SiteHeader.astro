---
import DottedMark from "./DottedMark.astro";
import { href } from "../lib/paths";
import { langLabels, listPath, ui, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  // Versions de cette page dans les autres langues (sinon : l'accueil de chaque langue).
  alternates?: { lang: Lang; path: string }[];
}
const { lang = "fr", alternates } = Astro.props;
const switcher = (["fr", "en", "pt"] as const).map((code) => ({
  code,
  label: langLabels[code],
  href: alternates?.find((item) => item.lang === code)?.path ?? (code === "fr" ? "/" : listPath(code)),
}));
const path = Astro.url.pathname;
const frLinks = [
  { href: "/guides", label: "Guides" },
  { href: "/outils", label: "Outils" },
  { href: "/faq", label: "FAQ" },
  { href: "/a-propos", label: "À propos" },
];
// Pages traduites : un lien vers la liste des guides de la langue, et un lien vers le site français.
const links =
  lang === "fr"
    ? frLinks
    : [
        { href: listPath(lang), label: ui[lang].guides },
      ];
const homeHref = lang === "fr" ? "/" : listPath(lang);

function isCurrent(target: string) {
  if (target === "/") return false;
  if (lang !== "fr") return path.startsWith(target);
  if (target === "/guides") return path.startsWith("/guides") || path.startsWith("/themes");
  return path.startsWith(target);
}
---

<!-- Le padding du bas garde la page à la même hauteur qu'avant (la ligne des langues est passée dans le menu). -->
<header class="px-5 pb-[52px] pt-6 sm:px-8">
  <div class="flex items-center justify-between">
    <a href={href(homeHref)} aria-label={ui[lang].home} class="flex items-center gap-2 text-[#171717]">
      <DottedMark />
      <span class="text-[15px] font-semibold tracking-[-0.01em]">Zunrel</span>
    </a>
    <div class="relative" data-menu>
      <button
        type="button"
        class="group -my-1.5 -mr-2 flex h-9 w-9 items-center justify-center rounded-md text-[#171717] hover:bg-black/[0.04] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#171717]"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menu"
        data-menu-button
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" class="group-aria-expanded:hidden" />
          <path d="M4 4l10 10M14 4L4 14" class="hidden group-aria-expanded:block" />
        </svg>
      </button>
      <div
        id="site-menu"
        hidden
        class="absolute right-0 top-full z-40 mt-2 w-56 rounded-md border border-[#e5e5e5] bg-white p-2 shadow-[0_8px_24px_rgba(0,0,0,0.06)]"
        data-menu-panel
      >
        <nav class="flex flex-col text-[15px] font-semibold leading-5 tracking-[-0.01em]">
          {
            links.map((link) => {
              const current = isCurrent(link.href);
              return (
                <a
                  href={href(link.href)}
                  aria-current={current ? "page" : undefined}
                  class={`rounded px-3 py-2 hover:bg-[#f5f5f5] ${current ? "text-[#0f4bf1]" : "text-[#171717]"}`}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>
        <nav
          aria-label="Langue / Language / Idioma"
          class="mt-2 flex gap-3 border-t border-[#e5e5e5] px-3 pb-1 pt-3 text-[12px] font-medium leading-4 tracking-[0.04em]"
        >
          {
            switcher.map((item) =>
              item.code === lang ? (
                <span aria-current="true" class="text-[#171717]">{item.label}</span>
              ) : (
                <a href={item.href} hreflang={item.code} class="text-[#a0a0a0] hover:text-[#171717]">
                  {item.label}
                </a>
              ),
            )
          }
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // Menu de l'en-tête : bouton, Échap, clic en dehors, clic sur un lien ou focus qui sort le referment.
  document.querySelectorAll<HTMLElement>("[data-menu]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>("[data-menu-button]")!;
    const panel = root.querySelector<HTMLElement>("[data-menu-panel]")!;
    const isOpen = () => button.getAttribute("aria-expanded") === "true";
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
    };
    button.addEventListener("click", () => setOpen(!isOpen()));
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (isOpen() && !root.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });
    root.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !root.contains(next)) setOpen(false);
    });
  });
</script>
