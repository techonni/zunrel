---
import { f, posts } from "../lib/site";
---

<ol class="list">
  {
    posts.map((post) => {
      const inner = (
        <Fragment>
          <time datetime={post.date}>{post.dateLabel}</time>
          <div class="tx">
            <h3>{f(post.title)}</h3>
            <p>{f(post.description)}</p>
          </div>
        </Fragment>
      );
      return <li><a href={`/blog/${post.slug}/`}>{inner}</a></li>;
    })
  }
</ol>
