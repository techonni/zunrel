---
// Les rubriques par format (express, complets). Seules celles qui contiennent des guides s'affichent :
// la rubrique « Guides complets » apparaîtra toute seule le jour où le premier guide long sera publié.
import { activeFormats, guidesInFormat } from "../lib/guides";
import { href } from "../lib/paths";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = activeFormats();
---

<div class:list={["m-list", className]}>
  {
    items.map((item) => {
      const count = guidesInFormat(item.format).length;
      return (
        <a
          href={href(`/formats/${item.slug}`)}
          class="m-row group"
        >
          <span class="m-body">
            <span class="block text-[13px] leading-5 text-[#95959b]">{item.label}</span>
            <span class="mt-1 block text-[15px] font-medium leading-5 text-white">{item.name}</span>
            <span class="mt-1 block text-[14px] leading-5 text-[#95959b]">{item.blurb}</span>
            <span class="mt-1 block text-[13px] leading-5 text-[#808086]">
              {count} {count === 1 ? "guide" : "guides"}
            </span>
          </span>
          <span class="m-arrow" aria-hidden="true">→</span>
        </a>
      );
    })
  }
</div>
