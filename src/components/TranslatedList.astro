---
// Liste des guides traduits d'une langue (/pt/ ou /en/).
import Base from "../layouts/Base.astro";
import { getGuide, guideFormat, type Guide } from "../lib/guides";
import { translatedPath, translations, ui, type OtherLang } from "../lib/i18n";

interface Props {
  lang: OtherLang;
}
const { lang } = Astro.props;
const t = ui[lang];
const items = translations[lang];
const groups = (["express", "complet"] as const)
  .map((format) => ({
    format,
    title: format === "express" ? t.quickGuides : t.completeGuides,
    list: items.filter((item) => guideFormat(getGuide(item.slug) as Guide) === format),
  }))
  .filter((group) => group.list.length > 0);
---

<Base
  lang={lang}
  title={t.listTitle}
  description={t.listIntro}
  alternates={[
    { lang: "fr", path: "/" },
    { lang: "pt", path: "/pt/" },
    { lang: "en", path: "/en/" },
  ]}
>
  <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em] text-white">{t.listTitle}</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">{t.listIntro}</p>
  {
    groups.map((group) => (
      <section class="mt-12">
        <h2 class="text-[13px] font-medium leading-5 text-white">
          {group.title} <span class="font-normal text-[#808086]">· {group.list.length}</span>
        </h2>
        <div class="mt-5 m-list">
          {group.list.map((item) => (
            <a href={translatedPath(lang, item.localSlug)} class="m-row group">
              <span class="m-body">
                <span class="block text-[15px] font-medium leading-5 text-white">{item.question}</span>
                <span class="mt-1 block text-[14px] leading-5 text-[#95959b]">{item.summary}</span>
              </span>
              <span class="m-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
  <p class="mt-12 text-[14px] leading-6">
    <a href="/" hreflang="fr" class="text-white underline underline-offset-4 decoration-[#808086] hover:decoration-white">Zunrel en français</a>
    ·
    <a href={lang === "pt" ? "/en/" : "/pt/"} hreflang={lang === "pt" ? "en" : "pt"} class="text-white underline underline-offset-4 decoration-[#808086] hover:decoration-white">{t.otherLang}</a>
  </p>
</Base>
