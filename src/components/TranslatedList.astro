---
// Liste des guides traduits d'une langue (/pt/ ou /en/).
import Base from "../layouts/Base.astro";
import { getGuide, guideFormat, type Guide } from "../lib/guides";
import { translatedPath, translations, ui, type OtherLang } from "../lib/i18n";
import { picInner, shortDate } from "../lib/v3";

interface Props {
  lang: OtherLang;
}
const { lang } = Astro.props;
const t = ui[lang];
const items = translations[lang];
const groups = (["express", "complet"] as const)
  .map((format) => ({
    format,
    title: format === "express" ? t.quickGuides : t.completeGuides,
    list: items.filter((item) => guideFormat(getGuide(item.slug) as Guide) === format),
  }))
  .filter((group) => group.list.length > 0);
---

<Base
  lang={lang}
  title={t.listTitle}
  description={t.listIntro}
  alternates={[
    { lang: "fr", path: "/" },
    { lang: "pt", path: "/pt/" },
    { lang: "en", path: "/en/" },
  ]}
>
  <h1>{t.listTitle}</h1>
  <p class="lede">{t.listIntro}</p>
  {
    groups.map((group) => (
      <section class="mt-24">
        <h2 class="sh">
          {group.title} <span>· {group.list.length}</span>
        </h2>
        <div class="glist">
          {group.list.map((item) => (
            <a href={translatedPath(lang, item.localSlug)} class="card">
              <div class="pic" set:html={picInner(item.slug, true)} />
              <div class="ct">
                <p class="date">{shortDate((getGuide(item.slug) as Guide).updatedOn, lang)}</p>
                <h4>{item.question}</h4>
                <p class="desc">{item.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
  <p class="mt-16 flex flex-wrap gap-3">
    <a href="/" hreflang="fr" class="pill light">Zunrel en français</a>
    <a href={lang === "pt" ? "/en/" : "/pt/"} hreflang={lang === "pt" ? "en" : "pt"} class="pill light">{t.otherLang}</a>
  </p>
</Base>
