---
// Guides d'un thème rangés par format : d'abord les guides express, puis les guides complets.
import GuideRow from "./GuideRow.astro";
import { formats, guideFormat, type Guide } from "../lib/guides";
import { href } from "../lib/paths";

interface Props {
  guides: Guide[];
}

const { guides } = Astro.props;
const groups = formats
  .map((item) => ({ item, list: guides.filter((guide) => guideFormat(guide) === item.format) }))
  .filter((group) => group.list.length > 0);
---

<div class="space-y-10">
  {
    groups.map(({ item, list }) => (
      <div>
        <a href={href(`/formats/${item.slug}`)} class="text-[13px] font-medium leading-5 text-white hover:underline">
          {item.name} <span class="font-normal text-[#808086]">· {list.length}</span>
        </a>
        <div class="mt-5 m-list">
          {list.map((guide) => <GuideRow guide={guide} />)}
        </div>
      </div>
    ))
  }
</div>
