---
// Inscription à la newsletter avec le formulaire « embedded » de Mailchimp.
// Pas de clé API ni de serveur : le formulaire envoie directement à Mailchimp,
// qui gère la confirmation par e-mail (double opt-in).
// Le visiteur ne quitte jamais la page : le script envoie l'adresse en arrière-plan
// (point d'accès JSONP « post-json » de Mailchimp) et affiche la réponse dans le bloc.
// Si Mailchimp ne répond pas, le formulaire est envoyé dans une iframe cachée.
// Le bloc ne s'affiche que si `newsletterFormUrl` est rempli dans src/lib/guides.ts.
// Tout le site parle de systeme.io : plus de choix de sujet. Seul le tag de langue de la page
// part dans le champ caché `tags` (voir `langTags`). Même liste et même formulaire Mailchimp qu'avant.
import { newsletterFormUrl, newsletterHoneypot } from "../lib/guides";
import { langTags, ui, type Lang } from "../lib/i18n";

interface Props {
  // Langue de la page : textes du bloc et tag Mailchimp de langue.
  lang?: Lang;
  title?: string;
  text?: string;
  // « light » : sur fond blanc/gris (champ bordé, bouton noir). « dark » : sur fond noir (bouton blanc).
  tone?: "light" | "dark";
  button?: string;
  // Niveau du titre (h2 par défaut).
  headingClass?: string;
}

const { lang = "fr", tone = "light", button, headingClass } = Astro.props;
const tr = lang === "fr" ? undefined : ui[lang];

const {
  title = tr ? tr.newsletterTitle : "Recevoir les prochains guides systeme.io",
  text = tr ? tr.newsletterText : "Les nouveaux guides systeme.io par e-mail, avec la checklist de lancement de votre premier tunnel en cadeau. Pas de spam, désinscription en un clic.",
} = Astro.props;

// Messages affichés par le script, dans la langue de la page.
const messages =
  lang === "pt"
    ? { send: "A enviar…", button: "Inscrever-me", thanks: "Obrigado!", confirm: "Último passo: abra o e-mail enviado para {email} e clique no botão para confirmar.", already: "Já está inscrito.", alreadyText: "Obrigado! Os próximos guias chegam ao seu e-mail.", invalid: "Escreva um e-mail válido, por exemplo voce@exemplo.com.", tooMany: "Muitas tentativas com este e-mail. Tente daqui a alguns minutos.", failed: "Não foi possível inscrever este e-mail. Verifique-o e tente de novo." }
    : lang === "en"
      ? { send: "Sending…", button: "Subscribe", thanks: "Thank you!", confirm: "Last step: open the email sent to {email} and click the button to confirm.", already: "You are already subscribed.", alreadyText: "Thank you! The next guides will arrive in your inbox.", invalid: "Enter a valid email address, for example you@example.com.", tooMany: "Too many attempts with this address. Try again in a few minutes.", failed: "This address could not be subscribed. Check it and try again." }
      : { send: "Envoi…", button: "S'inscrire", thanks: "Merci !", confirm: "Dernière étape : ouvrez l'e-mail envoyé à {email} et cliquez sur le bouton pour confirmer.", already: "Vous êtes déjà inscrit.", alreadyText: "Merci ! Les prochains guides arrivent dans votre boîte mail.", invalid: "Entrez une adresse e-mail valide, par exemple vous@exemple.com.", tooMany: "Trop de tentatives avec cette adresse. Réessayez dans quelques minutes.", failed: "Cette adresse n'a pas pu être inscrite. Vérifiez-la et réessayez." };
if (button) (messages as { button: string }).button = button;
const label = lang === "pt" ? "Seu e-mail" : lang === "en" ? "Your email address" : "Votre adresse e-mail";
---

{
  newsletterFormUrl ? (
    <div data-newsletter-block data-messages={JSON.stringify(messages)} class:list={["nlb no-print", tone]}>
      <div data-newsletter-intro>
        {title ? <h2 class={headingClass}>{title}</h2> : null}
        {text ? <p class="t">{text}</p> : null}
        <form action={newsletterFormUrl} method="post" target="zunrel-newsletter-frame" novalidate data-newsletter class="nlf">
          <input type="hidden" name="tags" value={langTags[lang]} />
          <label for="newsletter-email">{label}</label>
          <div class="row">
            <input
              id="newsletter-email"
              type="email"
              name="EMAIL"
              required
              autocomplete="email"
              inputmode="email"
              placeholder={lang === "pt" ? "voce@exemplo.com" : lang === "en" ? "you@example.com" : "vous@exemple.com"}
              aria-describedby="newsletter-help"
            />
            <div class="hp" aria-hidden="true">
              <input type="text" name={newsletterHoneypot} tabindex="-1" value="" />
            </div>
            <button type="submit">
              <span data-newsletter-spinner hidden class="spin" aria-hidden="true"></span>
              <span data-newsletter-label>{messages.button}</span>
            </button>
          </div>
          <p id="newsletter-help" data-newsletter-message aria-live="polite" class="msg">
            {tr ? tr.newsletterNote : "Vous recevrez un e-mail pour confirmer. Pas de spam, désinscription en un clic."}
          </p>
        </form>
      </div>

      <div data-newsletter-done hidden tabindex="-1" class="done">
        <span class="ok" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 6.2 5 8.5l4.5-5" stroke={tone === "dark" ? "#000" : "#fff"} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div>
          <strong data-newsletter-done-title>{messages.thanks}</strong>
          <p data-newsletter-done-text></p>
        </div>
      </div>

      <iframe name="zunrel-newsletter-frame" title="Inscription newsletter" hidden tabindex="-1"></iframe>
    </div>
  ) : null
}


<script is:inline>
  (function () {
    var form = document.querySelector("form[data-newsletter]");
    if (!form) return;
    var block = document.querySelector("[data-newsletter-block]");
    var intro = block.querySelector("[data-newsletter-intro]");
    var done = block.querySelector("[data-newsletter-done]");
    var doneTitle = block.querySelector("[data-newsletter-done-title]");
    var doneText = block.querySelector("[data-newsletter-done-text]");
    var message = block.querySelector("[data-newsletter-message]");
    var input = form.querySelector('input[name="EMAIL"]');
    var button = form.querySelector('button[type="submit"]');
    var spinner = button.querySelector("[data-newsletter-spinner]");
    var label = button.querySelector("[data-newsletter-label]");
    var defaultHelp = message.textContent;
    var storageKey = "zunrel-newsletter";
    var m = JSON.parse(block.getAttribute("data-messages") || "{}");

    function remember() {
      try {
        localStorage.setItem(storageKey, "1");
      } catch (e) {}
    }

    function setBusy(busy) {
      button.disabled = busy;
      spinner.hidden = !busy;
      label.textContent = busy ? m.send : m.button;
      input.readOnly = busy;
    }

    function setError(text) {
      input.setAttribute("aria-invalid", "true");
      message.textContent = text;
      message.style.color = "#d70015";
      input.focus();
    }

    function clearError() {
      input.removeAttribute("aria-invalid");
      message.textContent = defaultHelp;
      message.style.color = "";
    }

    function showDone(title, text, moveFocus) {
      doneTitle.textContent = title;
      doneText.textContent = text;
      // Garde la hauteur du bloc pour que la page ne saute pas, et centre le message.
      if (moveFocus !== false) block.style.minHeight = block.offsetHeight + "px";
      
      intro.hidden = true;
      done.hidden = false;
      if (moveFocus !== false) done.focus({ preventScroll: true });
    }

    // Déjà inscrit sur ce navigateur : un simple rappel au lieu du formulaire.
    try {
      if (localStorage.getItem(storageKey) === "1") {
        showDone(m.already, m.alreadyText, false);
      }
    } catch (e) {}

    input.addEventListener("input", function () {
      if (input.hasAttribute("aria-invalid")) clearError();
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (!input.value.trim() || !input.checkValidity()) {
        // Pas d'envoi : l'événement ne compte pas comme inscription dans les statistiques.
        event.stopPropagation();
        setError(m.invalid);
        return;
      }

      var email = input.value.trim();
      var name = "zunrelNewsletter" + Date.now();
      var url = form.action.replace("/subscribe/post?", "/subscribe/post-json?");
      var params = new URLSearchParams(new FormData(form));
      params.set("c", name);
      var script = document.createElement("script");
      var finished = false;

      function finish() {
        finished = true;
        clearTimeout(fallback);
        setBusy(false);
        delete window[name];
        script.remove();
      }

      function success() {
        remember();
        showDone(m.thanks, m.confirm.replace("{email}", email));
      }

      // Mailchimp ne répond pas : envoi classique dans l'iframe cachée, sans quitter la page.
      function sendInFrame() {
        if (finished) return;
        finish();
        form.submit();
        success();
      }

      var fallback = setTimeout(sendInFrame, 8000);

      window[name] = function (data) {
        if (finished) return;
        finish();
        var msg = (data && data.msg) || "";
        if (data && data.result === "success") {
          success();
        } else if (/already subscribed|déjà inscrit/i.test(msg)) {
          remember();
          showDone(m.already, m.alreadyText);
        } else if (/too many|trop de/i.test(msg)) {
          setError(m.tooMany);
        } else {
          setError(m.failed);
        }
      };

      clearError();
      setBusy(true);
      script.src = url + "&" + params.toString();
      script.onerror = sendInFrame;
      document.body.appendChild(script);
    });
  })();
</script>
