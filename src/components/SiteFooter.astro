---
import { href } from "../lib/paths";
import { ui, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;

const links = [
  { href: "/guides", label: "Guides" },
  { href: "/outils", label: "Outils" },
  { href: "/offres", label: "Offres du moment" },
  { href: "/newsletter", label: "Newsletter" },
  { href: "/a-propos", label: "À propos" },
  { href: "/kit-media", label: "Kit média" },
  { href: "/conditions-d-utilisation", label: "Conditions" },
];
---

<footer class="mt-28 pb-16">
  {lang === "fr" ? (
  <nav class="flex flex-wrap gap-x-5 gap-y-2 border-t border-[#292929] pt-6">
    {
      links.map((link) => (
        <a
          href={href(link.href)}
          class="text-[13px] leading-5 text-[#95959b] hover:text-white"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  ) : null}
  {lang === "fr" ? (
  <p class="mt-14 max-w-[520px] text-[13px] leading-5 text-[#808086]">
    Site indépendant, non édité par systeme.io. Informations à vérifier sur le site officiel avant
    toute décision. Les liens vers systeme.io sont des liens affiliés : si vous créez un compte via ces liens, je touche une commission, sans surcoût pour vous.
  </p>
  ) : (
    <p class="max-w-[520px] text-[13px] leading-5 text-[#808086]">{ui[lang].footer}</p>
  )}
  <p class="mt-2 text-[13px] leading-5 text-[#808086]">© 2026 Zunrel. Les noms cités appartiennent à leurs propriétaires.</p>
</footer>
