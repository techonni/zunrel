---
// Pied de page v3 : logo, phrase, 4 colonnes de liens, mention d'indépendance et d'affiliation.
import { logoSvg } from "../lib/v3";
import { ui, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}
const { lang = "fr" } = Astro.props;
const homeHref = lang === "pt" ? "/pt/" : lang === "en" ? "/en/" : "/";
const cols =
  lang === "fr"
    ? [
        { title: "Guides", links: [["/guides/", "Tous les guides"], ["/guides/c-est-quoi-systeme-io/", "Pour commencer"], ["/guides/lancer-son-business-en-ligne-avec-systeme-io-de-a-a-z/", "Le guide complet"], ["/themes/comparer/", "Comparatifs"]] },
        { title: "Fonctions", links: [["/guides/creer-un-tunnel-de-vente-systeme-io/", "Tunnel de vente"], ["/guides/creer-une-page-de-capture-systeme-io/", "Page de capture"], ["/guides/envoyer-une-newsletter-avec-systeme-io/", "Emailing"], ["/guides/creer-et-vendre-une-formation-en-ligne-systeme-io/", "Formations"]] },
        { title: "Thèmes", links: [["/themes/tunnels/", "Pages et tunnels"], ["/themes/vendre/", "Vendre en ligne"], ["/themes/emails/", "E-mails et automatisations"], ["/themes/affiliation/", "Affiliation"]] },
        { title: "Plus", links: [["/a-propos/", "À propos"], ["/newsletter/", "Newsletter"], ["/offres/", "Offres du moment"], ["/outils/", "Outils"], ["/kit-media/", "Kit média"], ["/conditions-d-utilisation/", "Conditions"]] },
      ]
    : lang === "pt"
      ? [
          { title: "Guias", links: [["/pt/", "Todos os guias"], ["/pt/guias/o-que-e-o-systeme-io/", "Para começar"], ["/pt/guias/quanto-custa-o-systeme-io/", "Preços"]] },
          { title: "Idiomas", links: [["/", "Français"], ["/en/", "English"]] },
        ]
      : [
          { title: "Guides", links: [["/en/", "All guides"], ["/en/guides/what-is-systeme-io/", "Getting started"], ["/en/guides/systeme-io-pricing/", "Pricing"]] },
          { title: "Languages", links: [["/", "Français"], ["/pt/", "Português"]] },
        ];
const tag =
  lang === "fr"
    ? "systeme.io, étape par étape. Des guides courts, en français."
    : lang === "pt"
      ? "systeme.io, passo a passo. Guias curtos e verificados."
      : "systeme.io, step by step. Short, checked guides.";
const legal =
  lang === "fr"
    ? "Site indépendant, non édité par systeme.io. Informations à vérifier sur le site officiel avant toute décision. Les liens vers systeme.io sont des liens affiliés : si vous créez un compte via ces liens, je touche une commission, sans surcoût pour vous."
    : ui[lang].footer;
const rights = lang === "fr" ? "© 2026 Zunrel. Les noms cités appartiennent à leurs propriétaires." : lang === "pt" ? "© 2026 Zunrel. Os nomes citados pertencem aos seus proprietários." : "© 2026 Zunrel. Names mentioned belong to their owners.";
---

<footer class="ft"><div class="w">
  <a class="fb" href={homeHref}><Fragment set:html={logoSvg(30)} /><b>Zunrel</b></a>
  <p class="ftag">{tag}</p>
  <div class="cols">
    {cols.map((col) => (
      <div><strong>{col.title}</strong>{col.links.map(([href, label]) => <a href={href}>{label}</a>)}</div>
    ))}
  </div>
  <div class="legal"><p>{legal}</p><p>{rights}</p></div>
</div></footer>
