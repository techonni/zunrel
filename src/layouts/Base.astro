---
import "../styles/site.css";
import { f, homeDescription, homeTitle, nav, ogImage, siteName, tagline } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  current?: string;
  noindex?: boolean;
  jsonLd?: object;
  image?: string;
  imageAlt?: string;
}

const { title, description = homeDescription, type = "website", current, noindex = false, jsonLd, image = ogImage, imageAlt } = Astro.props;
const documentTitle = title ? `${title} · ${siteName}` : homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${siteName} : ${tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="p:domain_verify" content="485d0834fb682f692cd0c2e316b227a8" />
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      var zConsent = null;
      try { zConsent = localStorage.getItem("zunrel-consent"); } catch (e) {}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: zConsent === "granted" ? "granted" : "denied",
      });
      gtag("js", new Date());
      gtag("config", "G-KC42X29LL9", { anonymize_ip: true });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KC42X29LL9"></script>
  </head>
  <body>
    <header class="hd">
      <div class="w">
        <a class="brand" href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="15" fill="#000"></rect><path d="M20 21h24L20 43h24" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{siteName}
        </a>
        <nav class="nav" aria-label="Menu">
          {nav.map((item) => <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="w">
        <span>© 2026 {siteName}. {f(tagline)}</span>
        <nav class="legal-links" aria-label="Pied de page">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="https://dariopinheiro.com/">Dário Pinheiro</a>
          <a href="/conditions-d-utilisation/">Conditions et cookies</a>
        </nav>
      </div>
    </footer>
    <div id="zunrel-consent" hidden class="cns">
      <p>{f("Zunrel mesure son audience avec Google Analytics, seulement si tu es d'accord.")}</p>
      <div class="b">
        <button type="button" data-consent="granted">Accepter</button>
        <button type="button" data-consent="denied">Refuser</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById("zunrel-consent");
        var saved = null;
        try { saved = localStorage.getItem("zunrel-consent"); } catch (e) {}
        if (!saved) box.hidden = false;
        box.addEventListener("click", function (event) {
          var choice = event.target.getAttribute && event.target.getAttribute("data-consent");
          if (!choice) return;
          try { localStorage.setItem("zunrel-consent", choice); } catch (e) {}
          gtag("consent", "update", { analytics_storage: choice });
          box.hidden = true;
          if (choice === "granted") window.zunrelVitals();
        });
      })();
    </script>
    <script is:inline>
      document.addEventListener("submit", function (event) {
        if (event.target.hasAttribute && event.target.hasAttribute("data-newsletter")) {
          gtag("event", "sign_up", { method: "newsletter", page: location.pathname });
        }
      });
    </script>
    <script is:inline>
      window.zunrelVitals = function () {
        if (window.zunrelVitalsStarted) return;
        window.zunrelVitalsStarted = true;
        import("https://cdn.jsdelivr.net/npm/web-vitals@4/+esm")
          .then(function (wv) {
            function send(metric) {
              gtag("event", "web_vital", {
                metric_name: metric.name,
                metric_value: metric.name === "CLS" ? Math.round(metric.value * 1000) / 1000 : Math.round(metric.value),
                metric_rating: metric.rating,
                page: location.pathname,
              });
            }
            wv.onLCP(send); wv.onINP(send); wv.onCLS(send); wv.onFCP(send); wv.onTTFB(send);
          })
          .catch(function () {});
      };
      try {
        if (localStorage.getItem("zunrel-consent") === "granted") window.zunrelVitals();
      } catch (e) {}
    </script>
  </body>
</html>
