---
import Base from "../../layouts/Base.astro";
import FormatGroups from "../../components/FormatGroups.astro";
import FormatCards from "../../components/FormatCards.astro";
import { guidesInTheme, themes } from "../../lib/guides";
import { href } from "../../lib/paths";
---

<Base title="Tous les guides" description="Tous les guides pratiques systeme.io, classés par thème : prix, tunnels, e-mails, vente, formations, affiliation.">
  <h1>Tous les guides</h1>
  <p class="lede">Classés par thème, puis en guides express (une question) et guides complets (un projet de A à Z), du plan gratuit à votre première vente.</p>
  <FormatCards class="mt-8" />
  {
    themes.map((theme) => {
      const list = guidesInTheme(theme.slug);
      if (list.length === 0) return null;
      return (
        <section class="mt-24">
          <h2 class="sh"><a href={href(`/themes/${theme.slug}`)}>{theme.name}.</a> <span>{theme.blurb}</span></h2>
          <div>
            <FormatGroups guides={list} />
          </div>
        </section>
      );
    })
  }
</Base>
