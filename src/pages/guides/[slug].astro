---
import Base from "../../layouts/Base.astro";
import GuideRow from "../../components/GuideRow.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import AffiliateCta from "../../components/AffiliateCta.astro";
import NewsletterBar from "../../components/NewsletterBar.astro";
import {
  formatDate,
  getGuide,
  seoDescription,
  getRelatedGuides,
  formats,
  affiliateLinks,
  affiliateDisclosure,
  guideFormat,
  readingMinutes,
  getTheme,
  getTool,
  guides,
  type Guide,
  type Tool,
} from "../../lib/guides";
import { href } from "../../lib/paths";
import { appIcon, iconOf, hasPhone, phone, checkPhone, shortDate } from "../../lib/v3";
import { guideAlternates } from "../../lib/i18n";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug } }));
}

const guide = getGuide(Astro.params.slug as string) as Guide;
const theme = getTheme(guide.theme);
const tools = guide.tools
  .map((item) => ({ tool: getTool(item.slug), why: item.why }))
  .filter((item): item is { tool: Tool; why: string } => item.tool !== undefined);
const related = getRelatedGuides(guide, 4);
const figAfter = hasPhone(guide.slug) && guide.steps.length > 3 ? 1 : -1;
const stepsA = figAfter >= 0 ? guide.steps.slice(0, figAfter + 1) : guide.steps;
const stepsB = figAfter >= 0 ? guide.steps.slice(figAfter + 1) : [];

const alternates = guideAlternates(guide.slug);
const format = formats.find((item) => item.format === guideFormat(guide));
const howTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: guide.question,
  description: guide.summary,
  inLanguage: "fr-FR",
  step: guide.steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.text,
  })),
};
---

<Base
  bare
  title={guide.seoTitle ?? guide.question}
  description={seoDescription(guide)}
  image={`/pins/minimal/${guide.slug}.jpg`}
  type="article"
  alternates={alternates}
  breadcrumbs={[
    { name: "Accueil", path: "/" },
    { name: "Guides", path: "/guides" },
    ...(theme ? [{ name: theme.name, path: `/themes/${theme.slug}` }] : []),
    { name: guide.question },
  ]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howTo)} />
  <meta slot="head" data-pagefind-meta="summary[content]" content={guide.summary} />
  <meta slot="head" data-pagefind-meta="minutes[content]" content={String(readingMinutes(guide))} />
  <meta slot="head" data-pagefind-filter="theme[content]" content={theme?.name ?? ""} />

  <article>
    <div class="art3">
      <p class="print-only hidden kat">Zunrel · zunrel.com/guides/{guide.slug}/</p>
      <p class="kat no-print">
        <a href={href("/guides")}>Guide</a>{theme ? <> · <a href={href(`/themes/${theme.slug}`)}>{theme.name}</a></> : null}{format ? <> · <a href={href(`/formats/${format.slug}`)}>{format.name}</a></> : null}
      </p>
      <h1 data-pagefind-body>{guide.question}</h1>
      <p class="subt">{guide.summary}</p>
      <div class="byl">
        <p>
          Par <a href={href("/a-propos")}>Dario Pinheiro</a>
          <time datetime={guide.updatedOn}>Mis à jour le {shortDate(guide.updatedOn)} · Lecture : {readingMinutes(guide)} min</time>
          {
            alternates ? (
              <span class="alt no-print">
                {alternates.slice(1).map((item, i) => (
                  <>{i > 0 ? " · " : ""}<a href={item.path} hreflang={item.lang}>{item.lang === "pt" ? "Em português" : "In English"}</a></>
                ))}
              </span>
            ) : null
          }
        </p>
        <span class="acts no-print">
          <button class="cp" type="button" data-print aria-label="Télécharger en PDF" title="Télécharger en PDF">
            <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19h14" /></svg>
          </button>
          <button class="cp" type="button" data-copy aria-label="Copier le lien de l'article" title="Copier le lien">
            <svg viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"/></svg><em>Lien copié</em>
          </button>
        </span>
      </div>
      <div class="pic" set:html={appIcon(iconOf(guide.slug))} />
    </div>

    <div class="prose" data-pagefind-body>
      <p>{guide.intro}</p>
      <AffiliateCta placement="haut" />

      <h2>{guideFormat(guide) === "complet" ? "Le parcours en bref" : "L'essentiel en 30 secondes"}</h2>
      <ol>{guide.steps.map((step) => <li>{step.title}</li>)}</ol>
      {guide.pitfalls[0] ? <p><strong>À éviter :</strong> {guide.pitfalls[0]}</p> : null}

      <h2 id="etapes">Étape par étape</h2>
      <ol class="steps3">
        {stepsA.map((step, index) => (
          <li>
            <h3><span>{index + 1}.</span>{step.title}</h3>
            {step.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
          </li>
        ))}
      </ol>
      {
        stepsB.length > 0 ? (
          <>
            <div class="pic fig" set:html={phone(guide.slug)} />
            <ol class="steps3" start={stepsA.length + 1}>
              {stepsB.map((step, index) => (
                <li>
                  <h3><span>{stepsA.length + index + 1}.</span>{step.title}</h3>
                  {step.text.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
                </li>
              ))}
            </ol>
          </>
        ) : null
      }

      <h2 class="no-print">Essayer par vous-même</h2>
      <AffiliateCta placement="bas" />

      {
        guide.pitfalls.length > 0 ? (
          <>
            <h2>Erreurs fréquentes</h2>
            <ul>{guide.pitfalls.map((pitfall) => <li>{pitfall}</li>)}</ul>
          </>
        ) : null
      }

      {
        tools.length > 0 ? (
          <>
            <h2>Outils utiles</h2>
            {tools.map((item) => (
              <p class="tools">
                <a class="out" href={affiliateLinks.fr} target="_blank" rel="sponsored noopener" data-affiliate={item.tool.slug} data-placement="outils">{item.tool.name}</a>
                {" "}: {item.why || item.tool.summary}{" "}
                <a href={href(`/outils/${item.tool.slug}`)}>Fiche de l'outil</a>{" "}
                <span style="color:#545454;font-size:.85em">({affiliateDisclosure.fr})</span>
              </p>
            ))}
          </>
        ) : null
      }

      {
        guide.sources.length > 0 ? (
          <>
            <h2>Sources officielles</h2>
            <ul>
              {guide.sources.map((source) => (
                <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
              ))}
            </ul>
          </>
        ) : null
      }

      <div class="no-print" data-pagefind-ignore style="margin-top:40px">
        <ShareButtons title={guide.question} slug={guide.slug} />
      </div>
    </div>
  </article>

  {
    related.length > 0 ? (
      <section class="more3 no-print" data-pagefind-ignore>
        <h3 class="sh">À lire ensuite</h3>
        <div class="list">{related.map((item) => <GuideRow guide={item} desc={false} />)}</div>
      </section>
    ) : null
  }

  <section class="sub3 no-print" id="checklist" data-pagefind-ignore>
    <NewsletterForm
      title="Recevez la checklist systeme.io gratuite"
      text="Votre premier tunnel en 10 étapes, du compte gratuit au premier achat test. Chaque étape renvoie vers un guide détaillé. Et les prochains guides par e-mail."
      button="Recevoir la checklist"
    />
    <div class="art" set:html={checkPhone()} />
  </section>
  <NewsletterBar gift="Recevez la checklist de lancement de votre premier tunnel systeme.io, et les prochains guides." />

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
        } catch {
          const t = document.createElement("textarea");
          t.value = location.href;
          document.body.append(t);
          t.select();
          document.execCommand("copy");
          t.remove();
        }
        button.classList.add("done");
        setTimeout(() => button.classList.remove("done"), 1600);
      });
    });
  </script>
</Base>
