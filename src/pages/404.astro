---
import Base from "../layouts/Base.astro";
import { f } from "../lib/site";
---

<Base title="Page introuvable" description="Cette page n'existe pas." noindex>
  <main class="w">
    <section class="oh page">
      <h1>Cette page n'existe pas.</h1>
      <p class="lead">{f("Le lien est peut-être ancien. Les articles sont tous sur le blog.")}</p>
      <a class="btn" href="/blog/">Voir le blog</a>
    </section>
  </main>
</Base>
