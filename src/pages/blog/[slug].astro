---
import Base from "../../layouts/Base.astro";
import Letter from "../../components/Letter.astro";
import "../../styles/article-links.css";
import { f, posts, siteName, type Post } from "../../lib/site";
import { articles } from "../../lib/articles";
import { readingMinutes } from "../../lib/articles/common";
import { previewSvg } from "../../lib/previews";

const related: Record<string, string[]> = {
  "notion-c-est-quoi": ["creer-ta-premiere-page-notion", "page-ou-base-de-donnees", "notion-est-il-gratuit"],
  "notion-est-il-gratuit": ["notion-c-est-quoi", "creer-ta-premiere-page-notion", "dupliquer-un-modele-notion"],
  "creer-ta-premiere-page-notion": ["notion-c-est-quoi", "page-ou-base-de-donnees", "les-proprietes-d-une-base-de-donnees"],
  "page-ou-base-de-donnees": ["les-proprietes-d-une-base-de-donnees", "les-vues-d-une-base-de-donnees", "creer-ta-premiere-page-notion"],
  "les-proprietes-d-une-base-de-donnees": ["page-ou-base-de-donnees", "les-vues-d-une-base-de-donnees", "filtrer-et-trier-sans-rien-perdre"],
  "les-vues-d-une-base-de-donnees": ["filtrer-et-trier-sans-rien-perdre", "les-proprietes-d-une-base-de-donnees", "page-ou-base-de-donnees"],
  "filtrer-et-trier-sans-rien-perdre": ["les-vues-d-une-base-de-donnees", "les-proprietes-d-une-base-de-donnees", "dupliquer-un-modele-notion"],
  "dupliquer-un-modele-notion": ["notion-c-est-quoi", "filtrer-et-trier-sans-rien-perdre", "les-vues-d-une-base-de-donnees"],
  "notion-sur-ton-telephone": ["notion-c-est-quoi", "creer-ta-premiere-page-notion", "creer-une-liste-de-taches-notion"],
  "creer-une-liste-de-taches-notion": ["filtrer-et-trier-sans-rien-perdre", "creer-ton-propre-modele-notion", "relier-deux-bases-de-donnees"],
  "creer-ton-propre-modele-notion": ["dupliquer-un-modele-notion", "creer-une-liste-de-taches-notion", "les-vues-d-une-base-de-donnees"],
  "relier-deux-bases-de-donnees": ["les-proprietes-d-une-base-de-donnees", "creer-une-liste-de-taches-notion", "page-ou-base-de-donnees"],
  "creer-un-calendrier-dans-notion": ["les-vues-d-une-base-de-donnees", "creer-une-liste-de-taches-notion", "filtrer-et-trier-sans-rien-perdre"],
  "prendre-des-notes-de-reunion-notion": ["creer-ton-propre-modele-notion", "creer-une-liste-de-taches-notion", "les-blocs-de-base-de-notion"],
  "les-blocs-de-base-de-notion": ["notion-c-est-quoi", "creer-ta-premiere-page-notion", "les-raccourcis-clavier-notion"],
  "organiser-ses-pages-avec-des-sous-pages": ["creer-ta-premiere-page-notion", "page-ou-base-de-donnees", "creer-une-page-d-accueil-notion"],
  "les-raccourcis-clavier-notion": ["les-blocs-de-base-de-notion", "notion-sur-ton-telephone", "creer-ta-premiere-page-notion"],
  "creer-un-suivi-des-habitudes-notion": ["les-proprietes-d-une-base-de-donnees", "filtrer-et-trier-sans-rien-perdre", "creer-une-liste-de-taches-notion"],
  "partager-une-page-notion": ["notion-est-il-gratuit", "dupliquer-un-modele-notion", "creer-ton-propre-modele-notion"],
  "ajouter-des-images-et-fichiers-notion": ["creer-ta-premiere-page-notion", "les-blocs-de-base-de-notion", "partager-une-page-notion"],
  "creer-un-tableau-kanban-notion": ["les-vues-d-une-base-de-donnees", "creer-une-liste-de-taches-notion", "creer-un-calendrier-dans-notion"],
  "utiliser-les-mentions-et-liens-notion": ["creer-une-page-d-accueil-notion", "les-raccourcis-clavier-notion", "organiser-ses-pages-avec-des-sous-pages"],
  "creer-une-page-d-accueil-notion": ["organiser-ses-pages-avec-des-sous-pages", "utiliser-les-mentions-et-liens-notion", "creer-une-liste-de-taches-notion"],
  "ranger-ses-lectures-et-idees-notion": ["page-ou-base-de-donnees", "les-vues-d-une-base-de-donnees", "creer-ton-propre-modele-notion"],
  "les-raccourcis-notion-a-connaitre": ["les-raccourcis-clavier-notion", "les-blocs-de-base-de-notion", "les-blocs-repliables"],
  "ranger-tes-pages-dans-la-barre-laterale": ["organiser-ses-pages-avec-des-sous-pages", "creer-une-page-d-accueil-notion", "retrouver-une-page-supprimee"],
  "les-blocs-repliables": ["les-blocs-de-base-de-notion", "les-raccourcis-notion-a-connaitre", "creer-ta-premiere-page-notion"],
  "ajouter-une-image-un-fichier-ou-un-lien": ["ajouter-des-images-et-fichiers-notion", "les-blocs-de-base-de-notion", "creer-ta-premiere-page-notion"],
  "les-mentions-et-les-rappels": ["utiliser-les-mentions-et-liens-notion", "les-raccourcis-notion-a-connaitre", "creer-une-liste-de-taches-notion"],
  "partager-une-page-notion-avec-un-lien": ["partager-une-page-notion", "publier-une-page-sur-le-web", "notion-est-il-gratuit"],
  "publier-une-page-sur-le-web": ["partager-une-page-notion", "partager-une-page-notion-avec-un-lien", "dupliquer-un-modele-notion"],
  "retrouver-une-page-supprimee": ["ranger-tes-pages-dans-la-barre-laterale", "organiser-ses-pages-avec-des-sous-pages", "notion-c-est-quoi"],
  "un-journal-quotidien-dans-notion": ["creer-ton-propre-modele-notion", "un-suivi-d-habitudes", "creer-ta-premiere-page-notion"],
  "un-suivi-d-habitudes": ["creer-un-suivi-des-habitudes-notion", "les-proprietes-d-une-base-de-donnees", "un-journal-quotidien-dans-notion"],
  "un-tableau-de-bord-personnel": ["creer-une-page-d-accueil-notion", "creer-une-liste-de-taches-notion", "utiliser-les-mentions-et-liens-notion"],
  "importer-tes-notes-dans-notion": ["ranger-tes-pages-dans-la-barre-laterale", "creer-ta-premiere-page-notion", "notion-c-est-quoi"],
};

export function getStaticPaths() {
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, next: posts[(i + 1) % posts.length] } }));
}

const { post, next } = Astro.props as { post: Post; next: Post };
const { body, caption, diagram } = articles[post.slug];
const minutes = readingMinutes(body);
const also = (related[post.slug] ?? []).map((slug) => posts.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const url = `https://zunrel.com/blog/${post.slug}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: "fr",
  author: { "@type": "Organization", name: siteName, url: "https://zunrel.com/" },
  publisher: { "@type": "Organization", name: siteName, url: "https://zunrel.com/" },
  mainEntityOfPage: url,
  image: `https://zunrel.com/og/${post.slug}.png`,
};
---

<Base title={post.title} description={f(post.description)} type="article" current="blog" jsonLd={jsonLd} image={`/og/${post.slug}.png`} imageAlt={`Aperçu : ${post.title}`}>
  <main class="w">
    <article>
      <header class="ah">
        <a class="back" href="/blog/">← Blog</a>
        <h1>{f(post.title)}</h1>
        <p class="meta"><time datetime={post.date}>{post.dateLabel}</time> · {minutes}&nbsp;min de lecture</p>
      </header>
      <div class="pv pv-top" set:html={previewSvg(post.slug)} />
      <div class="prose">
        {
          body.map((b) =>
            b[0] === "p" ? (
              <p>{f(b[1])}</p>
            ) : b[0] === "h2" ? (
              <h2>{f(b[1])}</h2>
            ) : b[0] === "ol" ? (
              <ol>{b[1].map((x) => <li>{f(x)}</li>)}</ol>
            ) : b[0] === "ul" ? (
              <ul>{b[1].map((x) => <li>{f(x)}</li>)}</ul>
            ) : (
              <figure>
                <Fragment set:html={diagram} />
                <figcaption>{f(caption)}</figcaption>
              </figure>
            ),
          )
        }
        {also.length > 0 && (
          <p>
            {f("Dans la même veine : ")}
            {also.map((p, i) => (
              <>
                {i > 0 ? ", " : ""}
                <a href={`/blog/${p.slug}/`}>{f(p.title)}</a>
              </>
            ))}
            .
          </p>
        )}
      </div>
    </article>
    <nav class="next" aria-label="Article suivant">
      <span>Article suivant</span>
      <a href={`/blog/${next.slug}/`}>{f(next.title)} →</a>
    </nav>
    <Letter id="email-article" />
  </main>
</Base>
