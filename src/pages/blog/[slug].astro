---
import Base from "../../layouts/Base.astro";
import Letter from "../../components/Letter.astro";
import { f, posts, siteName, type Post } from "../../lib/site";
import { articles } from "../../lib/articles";
import { readingMinutes } from "../../lib/articles/common";
import { previewSvg } from "../../lib/previews";

const related: Record<string, string[]> = {
  "enlever-les-pastilles-rouges": ["desencombrer-l-ecran-d-accueil-en-20-minutes", "les-notifications-a-heures-fixes", "choisir-des-apps-iphone-epurees"],
  "l-iphone-en-gris-le-soir": ["le-telephone-hors-de-la-chambre", "les-notifications-a-heures-fixes", "des-widgets-calmes-sur-l-ecran-verrouille"],
  "vider-safari-en-deux-minutes": ["une-seule-liste-pour-la-semaine", "desencombrer-l-ecran-d-accueil-en-20-minutes", "une-to-do-sans-bruit-avec-rappels"],
  "une-limite-pour-les-apps-qui-attirent": ["enlever-les-pastilles-rouges", "l-iphone-en-gris-le-soir", "les-notifications-a-heures-fixes"],
  "le-telephone-hors-de-la-chambre": ["l-iphone-en-gris-le-soir", "les-notifications-a-heures-fixes", "des-widgets-calmes-sur-l-ecran-verrouille"],
  "une-seule-liste-pour-la-semaine": ["une-to-do-sans-bruit-avec-rappels", "vider-safari-en-deux-minutes", "desencombrer-l-ecran-d-accueil-en-20-minutes"],
  "choisir-des-apps-iphone-epurees": ["enlever-les-pastilles-rouges", "une-limite-pour-les-apps-qui-attirent", "des-widgets-calmes-sur-l-ecran-verrouille"],
  "des-widgets-calmes-sur-l-ecran-verrouille": ["l-iphone-en-gris-le-soir", "les-notifications-a-heures-fixes", "choisir-des-apps-iphone-epurees"],
  "une-to-do-sans-bruit-avec-rappels": ["une-seule-liste-pour-la-semaine", "les-notifications-a-heures-fixes", "une-limite-pour-les-apps-qui-attirent"],
  "desencombrer-l-ecran-d-accueil-en-20-minutes": ["enlever-les-pastilles-rouges", "choisir-des-apps-iphone-epurees", "des-widgets-calmes-sur-l-ecran-verrouille"],
  "les-notifications-a-heures-fixes": ["enlever-les-pastilles-rouges", "l-iphone-en-gris-le-soir", "une-limite-pour-les-apps-qui-attirent"],
};

export function getStaticPaths() {
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, next: posts[(i + 1) % posts.length] } }));
}

const { post, next } = Astro.props as { post: Post; next: Post };
const { body, caption, diagram } = articles[post.slug];
const minutes = readingMinutes(body);
const also = (related[post.slug] ?? []).map((slug) => posts.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const url = `https://zunrel.com/blog/${post.slug}/`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: "fr",
  author: { "@type": "Organization", name: siteName, url: "https://zunrel.com/" },
  publisher: { "@type": "Organization", name: siteName, url: "https://zunrel.com/" },
  mainEntityOfPage: url,
  image: `https://zunrel.com/og/${post.slug}.png`,
};
---

<Base title={post.title} description={f(post.description)} type="article" current="blog" jsonLd={jsonLd} image={`/og/${post.slug}.png`} imageAlt={`Aperçu : ${post.title}`}>
  <main class="w">
    <article>
      <header class="ah">
        <a class="back" href="/blog/">← Blog</a>
        <h1>{f(post.title)}</h1>
        <p class="meta"><time datetime={post.date}>{post.dateLabel}</time> · {minutes}&nbsp;min de lecture</p>
      </header>
      <div class="pv pv-top" set:html={previewSvg(post.slug)} />
      <div class="prose">
        {
          body.map((b) =>
            b[0] === "p" ? (
              <p>{f(b[1])}</p>
            ) : b[0] === "h2" ? (
              <h2>{f(b[1])}</h2>
            ) : b[0] === "ol" ? (
              <ol>{b[1].map((x) => <li>{f(x)}</li>)}</ol>
            ) : b[0] === "ul" ? (
              <ul>{b[1].map((x) => <li>{f(x)}</li>)}</ul>
            ) : (
              <figure>
                <Fragment set:html={diagram} />
                <figcaption>{f(caption)}</figcaption>
              </figure>
            ),
          )
        }
        {also.length > 0 && (
          <p>
            {f("Dans la même veine : ")}
            {also.map((p, i) => (
              <>
                {i > 0 ? ", " : ""}
                <a href={`/blog/${p.slug}/`}>{f(p.title)}</a>
              </>
            ))}
            .
          </p>
        )}
      </div>
    </article>
    <nav class="next" aria-label="Article suivant">
      <span>Article suivant</span>
      <a href={`/blog/${next.slug}/`}>{f(next.title)} →</a>
    </nav>
    <Letter id="email-article" />
  </main>
</Base>
