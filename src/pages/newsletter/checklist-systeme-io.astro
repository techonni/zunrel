---
// Cadeau de la newsletter : checklist imprimable (bouton « Télécharger en PDF »).
// Chaque étape renvoie vers le guide qui l'explique en détail.
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getGuide } from "../../lib/guides";

const items = [
  { slug: "creer-son-compte-systeme-io", task: "Créer le compte gratuit et ouvrir les paramètres" },
  { slug: "connecter-son-nom-de-domaine-a-systeme-io", task: "Connecter votre nom de domaine (2 CNAME)" },
  { slug: "ameliorer-la-delivrabilite-de-ses-e-mails-systeme-io", task: "Confirmer l'expéditeur et authentifier le domaine d'envoi" },
  { slug: "creer-une-page-de-capture-systeme-io", task: "Créer la page de capture avec un cadeau gratuit" },
  { slug: "automatiser-avec-les-regles-systeme-io", task: "Envoyer l'e-mail de bienvenue avec une règle" },
  { slug: "creer-une-sequence-d-e-mails-automatique-systeme-io", task: "Écrire et publier la séquence de bienvenue" },
  { slug: "connecter-stripe-et-paypal-a-systeme-io", task: "Connecter Stripe ou PayPal" },
  { slug: "vendre-un-produit-numerique-avec-systeme-io", task: "Créer la page de paiement, le produit et son tarif" },
  { slug: "ajouter-un-upsell-un-order-bump-et-un-code-promo-systeme-io", task: "Ajouter un order bump ou un upsell" },
  { slug: "creer-un-tunnel-de-vente-systeme-io", task: "Tester tout le tunnel comme un client, achat compris" },
].map((item) => ({ ...item, guide: getGuide(item.slug) }));
---

<Base
  title="Checklist : lancer son premier tunnel systeme.io"
  description="Les 10 étapes à cocher avant de lancer votre premier tunnel systeme.io, avec un guide pas à pas pour chacune. À imprimer ou enregistrer en PDF."
>
  <h1 class="text-[22px] font-semibold leading-7 text-white">Checklist : lancer son premier tunnel systeme.io</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Les 10 étapes à cocher avant d'envoyer des visiteurs vers votre premier tunnel, dans l'ordre. Chaque étape renvoie vers un guide détaillé.
  </p>
  <div class="mt-6">
    <button
      type="button"
      data-print
      class="no-print inline-flex h-[30px] items-center gap-1.5 rounded-full border border-[#3a3a3c] bg-[#202020] px-3 text-[13px] font-medium text-white hover:bg-[#2c2c2e]"
    >
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
      Télécharger en PDF
    </button>
  </div>
  <script>
    document.querySelectorAll("[data-print]").forEach((button) => {
      button.addEventListener("click", () => window.print());
    });
  </script>

  <ol class="mt-10 m-list">
    {
      items.map((item, index) => (
        <li class="flex items-start gap-3 border-b border-[#292929] py-4">
          <span
            aria-hidden="true"
            class="mt-[2px] h-5 w-5 shrink-0 rounded-full border-2 border-[#8e8e93]"
          />
          <div>
            <p class="text-[15px] font-medium leading-6 text-white">
              {index + 1}. {item.task}
            </p>
            {item.guide ? (
              <a
                href={`/guides/${item.slug}/`}
                class="mt-1 inline-block text-[14px] leading-6 text-[#95959b] underline underline-offset-4 hover:text-white"
              >
                {item.guide.question}
              </a>
            ) : null}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-10 text-[13px] leading-5 text-[#808086]">
    Les prix, limites et libellés de systeme.io changent : vérifiez-les sur le site officiel avant de décider.
  </p>

  <NewsletterForm />
</Base>
