---
// Page d'arrivée après la confirmation d'inscription (redirection réglée dans Mailchimp).
import Base from "../../layouts/Base.astro";
import { guides } from "../../lib/guides";

const gifts = [
  { href: "/newsletter/checklist-systeme-io/", label: "Checklist : lancer son premier tunnel systeme.io", text: "Les 10 étapes à cocher, du compte gratuit au premier achat test." },
  { href: "/newsletter/modeles-landing-page/", label: "Modèles de textes pour page de capture", text: "Titres, boutons, formulaire et remerciement, à copier et compléter." },
];
const latest = [...guides].sort((a, b) => b.updatedOn.localeCompare(a.updatedOn)).slice(0, 3);
---

<Base title="Inscription confirmée" description="Votre inscription à la newsletter Zunrel est confirmée.">
  <h1>C'est confirmé, merci !</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Vous recevrez les prochains guides systeme.io par e-mail. Vous pouvez vous désinscrire à tout
    moment, en un clic, depuis chaque e-mail.
  </p>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Pour ne pas manquer nos e-mails, ajoutez <strong class="font-medium text-white">contact@zunrel.com</strong> à
    vos contacts. Si un e-mail arrive dans les indésirables, marquez-le comme « Pas un spam ».
  </p>
  <section class="mt-10 m-flat">
    <h2 class="text-[22px] font-semibold text-white">Vos cadeaux</h2>
    <p class="mt-3 text-[14px] leading-6 text-[#95959b]">
      À imprimer ou enregistrer en PDF, selon votre projet.
    </p>
    <ul class="mt-4 space-y-3">
      {
        gifts.map((gift) => (
          <li>
            <a href={gift.href} class="text-[15px] font-medium leading-6 text-white underline underline-offset-4 decoration-[#808086] hover:decoration-white">
              {gift.label}
            </a>
            <span class="block text-[14px] leading-6 text-[#95959b]">{gift.text}</span>
          </li>
        ))
      }
    </ul>
  </section>
  <h2 class="mt-12 text-[22px] font-semibold text-white">En attendant, les derniers guides</h2>
  <ul class="mt-4 space-y-3 text-[15px] leading-6">
    {
      latest.map((guide) => (
        <li>
          <a href={`/guides/${guide.slug}/`} class="text-white underline underline-offset-4 decoration-[#808086] hover:decoration-white">
            {guide.question}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 text-[15px] leading-6">
    <a href="/guides/" class="text-white underline underline-offset-4 decoration-[#808086] hover:decoration-white">Voir tous les guides</a>
  </p>
</Base>
