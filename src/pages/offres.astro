---
// « Meilleures offres du moment » : essais gratuits et promotions en cours.
// À mettre à jour chaque mois : changer `verifiedOn` et chaque offre, seulement avec ce qui est
// affiché sur les pages officielles le jour même (jamais de prix inventé).
import Base from "../layouts/Base.astro";
import { affiliateLink, formatDate, getGuide, shopifyLink } from "../lib/guides";
import { href } from "../lib/paths";

const verifiedOn = "2026-09-28";

const offers = [
  {
    tool: "shopify",
    name: "Shopify",
    headline: "3 jours gratuits, puis 1 € par mois pendant 3 mois",
    details: [
      "L'inscription est gratuite, sans engagement.",
      "Après les 3 jours d'essai, l'offre de lancement continue à 1 € par mois pendant 3 mois, puis le prix normal du forfait choisi.",
      "Shopify annonce aussi des crédits à gagner à mesure que vous vendez (conditions sur le site officiel).",
    ],
    href: shopifyLink,
    label: "Profiter de l'offre Shopify ↗",
    guides: ["essayer-shopify-gratuitement", "combien-coute-shopify", "creer-sa-boutique-shopify-de-a-a-z"],
  },
  {
    tool: "leadpages",
    name: "Leadpages et HTML Pub",
    headline: "7 jours d'essai gratuit sur toutes les offres",
    details: [
      "Chaque offre HTML Pub et Leadpages s'essaie pendant 7 jours, avec toutes ses fonctions.",
      "Une carte est demandée, mais rien n'est prélevé avant la fin de l'essai.",
      "Le paiement annuel revient environ 20 % moins cher que le paiement mensuel.",
    ],
    href: affiliateLink,
    label: "Essayer Leadpages 7 jours ↗",
    guides: ["essayer-leadpages-gratuitement", "combien-coute-leadpages", "choisir-entre-html-pub-et-leadpages"],
  },
].map((offer) => ({ ...offer, guides: offer.guides.map((slug) => getGuide(slug)).filter((guide) => guide !== undefined) }));
---

<Base
  title="Meilleures offres du moment"
  description="Les essais gratuits et promotions en cours pour Shopify, Leadpages et HTML Pub, vérifiés sur les sites officiels et mis à jour chaque mois."
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Meilleures offres du moment" }]}
>
  <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em] text-white">Meilleures offres du moment</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Les essais gratuits et promotions en cours pour Shopify, Leadpages et HTML Pub. Nous vérifions chaque offre sur le
    site officiel et mettons cette page à jour chaque mois.
  </p>
  <p class="mt-3 text-[13px] leading-5 text-[#808086]">Offres vérifiées le {formatDate(verifiedOn)}</p>

  <div class="mt-10 space-y-8">
    {
      offers.map((offer) => (
        <section class="rounded-[20px] border border-[#3a3a3c] bg-[#202020] p-6">
          <h2 class="text-[13px] leading-5 text-[#95959b]">{offer.name}</h2>
          <p class="mt-2 text-[18px] font-semibold leading-6 text-white">{offer.headline}</p>
          <ul class="mt-4 list-disc space-y-1.5 pl-5 text-[15px] leading-6 text-[#95959b]">
            {offer.details.map((detail) => <li>{detail}</li>)}
          </ul>
          <a
            href={offer.href}
            target="_blank"
            rel="sponsored noopener"
            data-affiliate={offer.tool}
            data-placement="offres"
            class="mt-5 inline-flex h-[39px] items-center rounded-full bg-white px-6 text-[14px] font-medium text-black hover:bg-[#e5e5e5]"
          >
            {offer.label}
          </a>
          <p class="mt-3 text-[13px] leading-5 text-[#808086]">Lien affilié : il ne change pas le prix pour vous.</p>
          <h3 class="mt-6 text-[13px] leading-5 text-[#95959b]">Pour en profiter</h3>
          <ul class="mt-2 space-y-1.5">
            {offer.guides.map((guide) => (
              <li>
                <a href={href(`/guides/${guide.slug}`)} class="text-[15px] leading-6 text-white hover:underline">
                  {guide.question} →
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="mt-10 text-[13px] leading-5 text-[#808086]">
    Les offres changent souvent et peuvent dépendre de votre pays. Vérifiez toujours les conditions sur le site
    officiel avant de payer.
  </p>
</Base>
