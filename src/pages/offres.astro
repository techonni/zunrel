---
// « Offres systeme.io du moment » : plan gratuit, annuel, migration.
// À mettre à jour chaque mois : changer `verifiedOn` et chaque offre, seulement avec ce qui est
// affiché sur les pages officielles le jour même (jamais de prix inventé).
import Base from "../layouts/Base.astro";
import { affiliateDisclosure, affiliateLinks, formatDate, getGuide } from "../lib/guides";
import { href } from "../lib/paths";

const verifiedOn = "2026-10-04";

// Sources : systeme.io/fr/pricing et aide.systeme.io (article 2003), relevés le 04/10/2026.
const offers = [
  {
    name: "Plan gratuit systeme.io",
    headline: "Gratuit, sans carte bancaire et sans limite de durée",
    details: [
      "Le plan gratuit inclut jusqu'à 2 000 contacts, 3 tunnels de vente, 1 domaine personnalisé et l'envoi d'e-mails illimité.",
      "Aucune carte bancaire n'est demandée à l'inscription, et la FAQ officielle indique que le plan gratuit n'expire pas.",
      "Limites à connaître : 1 campagne d'e-mails, 1 règle d'automatisation, 1 tag, 1 formation.",
    ],
    label: "Créer un compte gratuit ↗",
    guides: ["plan-gratuit-systeme-io", "creer-son-compte-systeme-io", "c-est-quoi-systeme-io"],
  },
  {
    name: "Paiement annuel",
    headline: "2 mois offerts en payant à l'année",
    details: [
      "Startup : 170 € par an au lieu de 17 € par mois. Webinaire : 470 € par an au lieu de 47 €. Illimité : 970 € par an au lieu de 97 €.",
      "La page des tarifs présente la facturation annuelle comme « 2 mois gratuits ».",
    ],
    label: "Voir les plans systeme.io ↗",
    guides: ["combien-coute-systeme-io"],
  },
  {
    name: "Migration gratuite",
    headline: "Votre ancien outil migré gratuitement par l'équipe systeme.io",
    details: [
      "D'après le centre d'aide, la migration complète est offerte avec le plan Illimité mensuel ou n'importe quel plan annuel.",
      "Elle comprend contacts, tunnels, blogs, formations, e-mails et automatisations, dans les limites du plan. Durée moyenne indiquée : 17 jours.",
    ],
    label: "Découvrir systeme.io ↗",
    guides: ["migrer-vers-systeme-io", "systeme-io-ou-leadpages", "systeme-io-ou-shopify"],
  },
].map((offer) => ({ ...offer, guides: offer.guides.map((slug) => getGuide(slug)).filter((guide) => guide !== undefined) }));
---

<Base
  title="Offres systeme.io du moment"
  description="Plan gratuit, 2 mois offerts en annuel et migration gratuite : les offres systeme.io en cours, vérifiées sur le site officiel."
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Offres systeme.io du moment" }]}
>
  <h1 class="text-[26px] font-semibold leading-8 tracking-[-0.015em] text-white">Offres systeme.io du moment</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Ce que systeme.io offre en ce moment : plan gratuit, réduction en annuel, migration gratuite. Chaque offre est
    vérifiée sur le site officiel, et cette page est mise à jour chaque mois.
  </p>
  <p class="mt-3 text-[13px] leading-5 text-[#808086]">Offres vérifiées le {formatDate(verifiedOn)}</p>

  <div class="mt-10 space-y-12">
    {
      offers.map((offer) => (
        <section class="m-flat">
          <h2 class="text-[13px] leading-5 text-[#95959b]">{offer.name}</h2>
          <p class="mt-2 text-[18px] font-semibold leading-6 text-white">{offer.headline}</p>
          <ul class="mt-4 list-disc space-y-1.5 pl-5 text-[15px] leading-6 text-[#95959b]">
            {offer.details.map((detail) => <li>{detail}</li>)}
          </ul>
          <a
            href={affiliateLinks.fr}
            target="_blank"
            rel="sponsored noopener"
            data-affiliate="systeme-io"
            data-placement="offres"
            class="mt-5 inline-flex h-[39px] items-center rounded-full bg-white px-6 text-[14px] font-medium text-black hover:bg-[#e5e5e5]"
          >
            {offer.label}
          </a>
          <p class="mt-3 text-[13px] leading-5 text-[#808086]">{affiliateDisclosure.fr}</p>
          <h3 class="mt-6 text-[13px] leading-5 text-[#95959b]">Pour en profiter</h3>
          <ul class="mt-2 m-list">
            {offer.guides.map((guide) => (
              <li>
                <a href={href(`/guides/${guide.slug}`)} class="m-row group !py-3 text-[15px] leading-6 text-white">
                  <span class="m-body">{guide.question}</span>
                  <span class="m-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="mt-10 text-[13px] leading-5 text-[#808086]">
    Les offres changent souvent et peuvent dépendre de votre pays (prix ci-dessus en euros, page française). Vérifiez toujours les conditions sur le site
    officiel avant de payer.
  </p>
</Base>
