---
import Base from "../../layouts/Base.astro";
import GuideRow from "../../components/GuideRow.astro";
import { activeFormats, guidesInFormat, guidesInTheme, themes, guideFormat } from "../../lib/guides";
import { href } from "../../lib/paths";

export function getStaticPaths() {
  return activeFormats().map((item) => ({ params: { format: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const total = guidesInFormat(item.format).length;
---

<Base
  title={item.name}
  description={item.blurb}
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Guides", path: "/guides" }, { name: item.name }]}
>
  <h1>{item.name}</h1>
  <p class="lede">{item.blurb}</p>
  <p class="mt-2 text-[13px] leading-5 text-[#808086]">{total} {total === 1 ? "guide" : "guides"}</p>
  {
    themes.map((theme) => {
      const list = guidesInTheme(theme.slug).filter((guide) => guideFormat(guide) === item.format);
      if (list.length === 0) return null;
      return (
        <section class="mt-24">
          <h2 class="sh"><a href={href(`/themes/${theme.slug}`)}>{theme.name}</a></h2>
          <div class="glist">
            {list.map((guide) => <GuideRow guide={guide} />)}
          </div>
        </section>
      );
    })
  }
</Base>
