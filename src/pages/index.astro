---
import Base from "../layouts/Base.astro";
import Letter from "../components/Letter.astro";
import PostList from "../components/PostList.astro";
import { f, homeDescription, promise, promiseSub, siteName, tagline } from "../lib/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: "https://zunrel.com/",
  description: homeDescription,
  inLanguage: "fr",
};
---

<Base jsonLd={jsonLd}>
  <main class="w">
    <section class="hero">
      <p class="kick">{f(tagline)}</p>
      <h1>{f(promise)}</h1>
      <p>{f(promiseSub)}</p>
      <a class="btn" href="/blog/">Lire le blog</a>
    </section>
    <section id="blog">
      <h2 class="sl">Blog</h2>
      <PostList />
    </section>
    <section class="comm">
      <h2>{f("Une communauté, pas un fil d'actualité")}</h2>
      <p>{f("Zunrel avance avec ses lecteurs. Chaque lettre se termine par une question ; tes réponses, tes blocages et tes pages Notion nourrissent les articles suivants.")}</p>
    </section>
    <Letter id="email-home" />
  </main>
</Base>
