---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";
import { guides, guidesInFormat, themes, tools } from "../lib/guides";

const express = guidesInFormat("express").length;
const complet = guidesInFormat("complet").length;
const activeThemes = themes.filter((theme) => guides.some((guide) => guide.theme === theme.slug));

const stats = [
  { value: String(guides.length), label: "guides publiés" },
  { value: String(complet), label: complet > 1 ? "guides complets (A à Z)" : "guide complet (A à Z)" },
  { value: "3", label: "langues (FR, PT, EN)" },
];

const facts = [
  {
    title: "Ce que fait Zunrel",
    body: "Zunrel publie des guides « comment faire », étape par étape, en français (et en portugais et anglais pour les guides essentiels), pour lancer et développer son activité en ligne avec systeme.io : tunnels de vente, e-mails, produits numériques, formations, affiliation. Chaque guide répond à une seule question qu'un débutant tape sur Google, avec les étapes dans l'ordre réel, les erreurs fréquentes et les liens vers l'aide officielle.",
  },
  {
    title: "Audience",
    body: "Des francophones qui lancent ou développent une activité en ligne : indépendants, auto-entrepreneurs, créateurs, petites entreprises (1 à 100 personnes). Principalement en Europe francophone (France, Belgique, Suisse). Ils arrivent avec une intention précise : comprendre systeme.io, l'essayer, le configurer.",
  },
  {
    title: "Formats",
    body: `Guides express (${express}) : l'essentiel se lit en 30 secondes. Guides complets (${complet}) : un projet de A à Z, plus de 10 minutes de lecture. Chaque guide existe aussi en épingle Pinterest verticale et peut être imprimé ou enregistré en PDF.`,
  },
  {
    title: "Diffusion",
    body: "Référencement naturel (Google : sitemap, données structurées HowTo) et Pinterest (compte zunrel, une épingle par guide). Pas de publicité payante ni d'achat de trafic.",
  },
];

const principles = [
  "Liens affiliés toujours signalés, avec rel=\"sponsored\".",
  "Les limites de chaque offre sont écrites noir sur blanc, même quand elles ne vendent pas.",
  "Prix, libellés et fonctions vérifiés sur l'interface réelle à chaque mise à jour, avec la date indiquée.",
  "Pas d'avis inventés, pas de faux témoignages, pas de promesses de revenus.",
  "Aucune utilisation de marque par enchère sur le nom (brand bidding) ni de coupons non autorisés.",
];
---

<Base title="Kit média" description="Zunrel en bref : audience, formats, diffusion et principes, pour les programmes partenaires.">
  <h1 class="text-[22px] font-semibold leading-7 text-white">Kit média</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Zunrel en bref, pour les programmes partenaires et les marques. Les chiffres ci-dessous sont calculés
    automatiquement à partir du contenu publié.
  </p>

  <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 min-[640px]:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="border-t border-[#292929] pt-4">
          <p class="text-[22px] font-semibold leading-7 text-white">{stat.value}</p>
          <p class="mt-1 text-[13px] leading-5 text-[#95959b]">{stat.label}</p>
        </div>
      ))
    }
  </div>

  {
    facts.map((fact) => (
      <section class="mt-10">
        <h2 class="text-[15px] font-medium leading-5 text-white">{fact.title}</h2>
        <p class="mt-3 text-[15px] leading-6 text-[#95959b]">{fact.body}</p>
      </section>
    ))
  }

  <section class="mt-10">
    <h2 class="text-[15px] font-medium leading-5 text-white">Outil et rubriques couverts</h2>
    <p class="mt-3 text-[15px] leading-6 text-[#95959b]">
      {tools.map((tool) => tool.name).join(", ")}. Rubriques : {activeThemes.map((theme) => theme.name).join(", ")}.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-[15px] font-medium leading-5 text-white">Nos principes</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-[15px] leading-6 text-[#95959b]">
      {principles.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-[15px] font-medium leading-5 text-white">Travailler avec Zunrel</h2>
    <p class="mt-3 text-[15px] leading-6 text-[#95959b]">
      Depuis octobre 2026, Zunrel ne parle que de systeme.io et participe à son programme d'affiliation officiel.
      Les guides essentiels existent en français, en portugais et en anglais.
    </p>
  </section>

  <p class="mt-10 text-[15px] leading-6 text-[#95959b]">
    Voir aussi : <a href={href("/a-propos")} class="text-white underline underline-offset-2">À propos</a> ·
    <a href={href("/conditions-d-utilisation")} class="text-white underline underline-offset-2">Conditions d'utilisation</a>
  </p>
</Base>
