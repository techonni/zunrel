---
import Base from "../../layouts/Base.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import GuideRow from "../../components/GuideRow.astro";
import { getTool, guidesUsingTool, toolLink, tools, type Tool } from "../../lib/guides";

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const tool = getTool(Astro.params.slug as string) as Tool;
const usedIn = guidesUsingTool(tool.slug);
const isAffiliate = Boolean(tool.affiliateUrl);
---

<Base
  title={tool.name}
  description={tool.summary}
  breadcrumbs={[{ name: "Accueil", path: "/" }, { name: "Outils", path: "/outils" }, { name: tool.name }]}
>
  <BrandLogo tool={tool} size="lg" />
  <h1 class="mt-6 text-[22px] font-semibold leading-7 text-white">{tool.name}</h1>
  <p class="mt-3 text-[15px] leading-6 text-[#95959b]">{tool.summary}</p>
  <p class="mt-4 text-[14px] leading-5 text-[#95959b]">
    Formule gratuite : {tool.freePlan ? "oui" : "non, essai ou abonnement"}.
  </p>

  <section class="mt-12">
    <h2 class="text-[13px] leading-5 text-[#95959b]">Pour qui</h2>
    <p class="mt-3 text-[15px] leading-6 text-[#95959b]">{tool.goodFor}</p>
  </section>

  <section class="mt-10">
    <h2 class="text-[13px] leading-5 text-[#95959b]">À surveiller</h2>
    <p class="mt-3 text-[15px] leading-6 text-[#95959b]">{tool.watchOut}</p>
  </section>

  <a
    href={toolLink(tool)}
    target="_blank"
    rel={isAffiliate ? "sponsored noopener" : "noopener"}
    data-affiliate={isAffiliate ? tool.slug : undefined}
    data-placement={isAffiliate ? "fiche" : undefined}
    class="mt-10 inline-flex h-[39px] items-center rounded-full bg-white px-6 text-[14px] font-medium text-black hover:bg-[#e5e5e5]"
  >
    Voir le site de {tool.name} ↗
  </a>
  {
    isAffiliate ? (
      <p class="mt-3 text-[13px] leading-5 text-[#808086]">Lien affilié : il ne change pas le prix pour vous.</p>
    ) : null
  }

  {
    usedIn.length > 0 ? (
      <section class="mt-14">
        <h2 class="text-[13px] leading-5 text-[#95959b]">Cité dans</h2>
        <div class="mt-6 m-list">
          {usedIn.map((guide) => <GuideRow guide={guide} />)}
        </div>
      </section>
    ) : null
  }
</Base>
