---
import Base from "../../layouts/Base.astro";
import ToolRow from "../../components/ToolRow.astro";
import { themes, tools } from "../../lib/guides";
---

<Base title="Outils" description="systeme.io, l'outil présenté dans tous les guides Zunrel : à qui il sert, et à quoi faire attention.">
  <h1>Outils</h1>
  <p class="mt-4 text-[15px] leading-6 text-[#95959b]">
    Zunrel ne présente qu'un outil : systeme.io. À qui il sert, et à quoi faire attention.
  </p>
  {
    themes.map((theme) => {
      const list = tools.filter((tool) => tool.themes[0] === theme.slug);
      if (list.length === 0) return null;
      return (
        <section class="mt-14">
          <h2 class="sh">{theme.name}</h2>
          <div class="mt-6 m-list">
            {list.map((tool) => <ToolRow tool={tool} />)}
          </div>
        </section>
      );
    })
  }
</Base>
